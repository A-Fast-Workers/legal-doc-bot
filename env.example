# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ авторизации GigaChat API (developers.sber.ru -> Studio -> API-ключ)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2

# Сертификаты Минцифры: либо путь к файлу (рекомендуется), либо отключение проверки
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=false

# Необязательно
# ALLOWED_USER_IDS=123456789,987654321
# REQUESTS_PER_HOUR=15
# MAX_FILE_MB=10
# SESSION_TTL_MINUTES=60
